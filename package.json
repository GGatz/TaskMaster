{
  "name": "taskmaster-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "A Notion-style workspace: nested pages, a block editor, and databases with table, board, list, gallery and calendar views.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "start": "vite build && node server/index.js",
    "server": "node server/index.js",
    "build": "vite build",
    "test": "node --test \"server/test/*.test.js\" \"src/lib/*.test.js\"",
    "e2e": "node e2e/run.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "vite": "^7.0.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
